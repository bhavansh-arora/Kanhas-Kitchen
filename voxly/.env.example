# Copy to .env (never commit it) and fill in.

# Claude API key, from https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=""

# Your admin login for /admin. Use a strong password -- this account can see
# every business. Changing ADMIN_PASSWORD here and restarting resets it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# The public address of this server, used in the website script you give
# customers. Must be HTTPS so microphones work on customers' websites.
PUBLIC_URL="https://voxly.codebunny.net"

# Optional: which Claude models to use (defaults shown).
# CHAT_MODEL answers website visitors; claude-haiku-5-5 is much cheaper and
# faster if you want to trade some answer quality for cost.
# CHAT_MODEL="claude-opus-5-5"
# CHAT_EFFORT="low"
# OWNER_MODEL="claude-opus-5-5"
# EXTRACT_MODEL="claude-opus-5-5"

# Optional: visitor messages allowed per minute from one address (default 20).
# CHAT_PER_MINUTE=20

# Landing page (/). Bot key of the business whose assistant powers the
# "Talk to it now" button (see README: Setting up the landing page's live demo).
LANDING_BOT_KEY=""
# Your WhatsApp number with country code, digits only (shows a WhatsApp button).
CONTACT_WHATSAPP=""
# Optional: Slack/Discord/n8n webhook notified of each new demo request.
NOTIFY_WEBHOOK_URL=""
