# Copy this to .env (gitignored, never commit real credentials) and fill in.

# Login for the panel. The values in the README/server.js defaults are
# public on GitHub -- always set a real password here before going live.
PANEL_USER="bhavansharora21@gmail.com"
PANEL_PASSWORD=""

# Internal port the Node process listens on. No need to change this for a
# normal deploy -- it's never exposed to the host, only reached inside the
# Docker network by the reverse proxy in front of it.
PORT=3000
